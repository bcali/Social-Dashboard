# __PROJECT_NAME__ Environment Variables
# Copy this file to .env and customize as needed

# Gamma Proxy URL (required for AI presentation generation)
# Points to the Cloudflare Worker that proxies Gamma API requests
# VITE_GAMMA_PROXY_URL=https://gamma-proxy.<your-subdomain>.workers.dev

# GitHub Proxy URL (required for inline editing from dashboard → git)
# Points to the Cloudflare Worker that proxies GitHub API commits
# VITE_GITHUB_PROXY_URL=https://github-proxy.<your-subdomain>.workers.dev

# Vite base path — set to / for local dev, leave unset for GitHub Pages
# VITE_BASE_PATH=/
